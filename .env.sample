# The session environment. step1_env.sh copies this to .env (gitignored);
# steps 2 and 4 run `source .env` before doing anything, so every command
# runs with the same provider credentials and TF_VAR_* values — the "one
# shell session" demonolith documents as its prerequisite, since it
# deliberately captures neither.
#
# Keep the `export` prefixes: only exported values reach tofu and demonolith.

# State-store credentials — the values docker-compose.yml starts MinIO
# with. They are passed to init as -backend-config flags (see
# step2_baseline.sh), never written into HCL; demonolith materializes them
# into gitignored per-module demono.env files as AWS_ACCESS_KEY_ID /
# AWS_SECRET_ACCESS_KEY. They authenticate against the local container
# only — no AWS anywhere.
export STATE_STORE_ACCESS_KEY="minioadmin"
export STATE_STORE_SECRET_KEY="minioadmin"

# Variable values that live only in the environment (the TF_VAR_* channel).
export TF_VAR_resource_group_name="acme-prod"
export TF_VAR_vpc_cidr_block="10.0.0.0/16"
